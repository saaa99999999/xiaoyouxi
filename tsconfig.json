{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["vitest/globals"],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "entry/src/main/ets/**/*.ts",
    "entry/src/main/ets/**/*.d.ts",
    "entry/src/test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
